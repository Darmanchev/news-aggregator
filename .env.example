# Optional collection-failure email alerts: set all three, or leave all absent.
# Use a sender address verified in Resend and a single recipient address.
# RESEND_API_KEY=re_replace_me
# ALERT_EMAIL_FROM=news@example.com
# ALERT_EMAIL_TO=you@example.com
