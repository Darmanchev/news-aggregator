MONGODB_URI=mongodb://127.0.0.1:27018/bulgarian_news
PORT=3000

# Optional AI topic tagging; absent key keeps keyword tagging with no external AI calls.
# Obtain a Singapore-region Alibaba Model Studio API key. Never use a VITE_ prefix.
# QWEN_API_KEY=replace_me
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Optional collection-failure email alerts: set all three, or leave all absent.
# Use a sender address verified in Resend and a single recipient address.
# RESEND_API_KEY=re_replace_me
# ALERT_EMAIL_FROM=news@example.com
# ALERT_EMAIL_TO=you@example.com
