{
  "name": "bulgarian-news",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web,collector \"npm run dev -w @news/api\" \"npm run dev -w @news/web\" \"npm run collect:watch -w @news/api\"",
    "build": "npm run build -w @news/web && npm run build -w @news/api",
    "typecheck": "npm run typecheck --workspaces",
    "test": "vitest run",
    "collect": "npm run collect -w @news/api",
    "collect:watch": "npm run collect:watch -w @news/api",
    "collect:prod": "npm run collect:prod -w @news/api",
    "worker": "npm run worker -w @news/api",
    "start": "npm run start -w @news/api",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "photos:backfill": "npm run photos:backfill -w @news/api"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.5",
    "jsdom": "^30.1.3",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
