{
  "name": "@news/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "collect": "tsx --env-file-if-exists=../../.env src/jobs/collect-news.ts",
    "collect:watch": "tsx --env-file-if-exists=../../.env src/jobs/collect-news.ts --watch",
    "collect:prod": "node --env-file-if-exists=../../.env dist/jobs/collect-news.js",
    "worker": "node --env-file-if-exists=../../.env dist/jobs/collect-news.js --watch",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "photos:backfill": "tsx --env-file-if-exists=../../.env src/jobs/backfill-photos.ts",
    "tags:backfill": "node --import tsx --env-file-if-exists=../../.env src/jobs/backfill-tags.ts"
  },
  "dependencies": {
    "entities": "^7.0.1",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.11.2",
    "rss-parser": "^3.13.0"
  }
}
